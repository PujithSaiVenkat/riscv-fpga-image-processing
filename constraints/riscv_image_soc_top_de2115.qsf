# =====================================================================
# riscv_image_soc_top_de2115.qsf
# Quartus II / Quartus Prime settings file for the Terasic DE2-115 board
# FPGA Implementation of a RISC-V SoC for Image Processing Applications
#
# Pin numbers transcribed from DE2_115_User_manual.pdf:
#   Table 4-5  (Clock Inputs), Table 4-2 (Push-buttons), Table 4-1 (Slide
#   Switches), Table 4-3 (LEDs), Table 4-12 (Expansion Header / GPIO),
#   Table 4-16 (ADV7123 VGA DAC).
#
# GPIO[15:0] camera mapping is an ASSUMPTION, not a documented DE2-115
# pinout -- the board has no dedicated camera header. Confirm against your
# actual OV7670-to-GPIO wiring before programming the board. See the header
# comment in riscv_image_soc_top_de2115.sv for the full mapping rationale.
#
# Device speed grade (C7) is the standard shipped DE2-115 grade; the manual
# itself only states EP4CE115F29 without a grade suffix. Confirm against the
# part marking on your board or Quartus's own board part number if in doubt.
# =====================================================================

set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE115F29C7
set_global_assignment -name TOP_LEVEL_ENTITY riscv_image_soc_top_de2115
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY "C:/Users/ragha/Desktop/riscv_image_soc_de2115/riscv_image_soc_de2115/output_files"
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 1
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL

# ---------------------------------------------------------------------
# RTL source files, in dependency order (leaves first).
# Adjust the path prefix if you place rtl/ elsewhere in your project.
# ---------------------------------------------------------------------
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/adder.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/program_counter.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/alu.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/alu_control.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/branch_unit.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/imm_generator.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/register_file.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/main_control.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/if_id_reg.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/id_ex_reg.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/ex_mem_reg.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/mem_wb_reg.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/forwarding_unit.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/hazard_detection_unit.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/fetch_stage.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/decode_stage.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/execute_stage.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/writeback_stage.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/datapath.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/memory/instruction_memory_fpga.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/memory/data_memory_fpga.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ipu/ipu_fpga.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/rv32i_core_fpga.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/camera/ov7670_sccb_init.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/camera/ov7670_capture_128_rgb565_to_rgb888.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/display/vga_640x480.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/display/vga_frame_display.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/top/riscv_image_soc_top_de2115.sv

# --- Clock input (Table 4-5) ---
set_location_assignment PIN_Y2 -to CLOCK_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to CLOCK_50

# --- Push-buttons / reset (Table 4-2). Default JP7 = 3.3-V LVTTL. ---
set_location_assignment PIN_M23 -to KEY[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to KEY[0]
set_location_assignment PIN_M21 -to KEY[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to KEY[1]
